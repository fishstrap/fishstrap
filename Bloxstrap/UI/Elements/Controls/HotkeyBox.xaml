<UserControl x:Class="Bloxstrap.UI.Elements.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <ui:Button x:Name="Recorder" MinWidth="170" Appearance="Secondary" HorizontalContentAlignment="Center"
               Click="RecorderClicked"
               PreviewKeyDown="RecorderKeyDown"
               PreviewKeyUp="RecorderKeyUp"
               LostKeyboardFocus="RecorderLostFocus">
        <TextBlock x:Name="ShortcutText" />
    </ui:Button>
</UserControl>
