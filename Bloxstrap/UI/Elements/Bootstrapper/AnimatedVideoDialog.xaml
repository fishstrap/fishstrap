<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Bootstrapper.AnimatedVideoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    Width="620"
    Height="360"
    MinWidth="420"
    MinHeight="260"
    Background="#FF080808"
    Closing="UiWindow_Closing"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Background="#FF080808">
        <MediaElement x:Name="VideoSurface"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      MediaOpened="VideoSurface_MediaOpened"
                      MediaEnded="VideoSurface_MediaEnded"
                      MediaFailed="VideoSurface_MediaFailed" />
        <Border Background="#66000000" VerticalAlignment="Bottom" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="Windows11Indicator" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Stroke="#FFFFFFFF" StrokeThickness="3" StrokeDashArray="1,2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <Grid x:Name="Windows10Indicator" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed">
                    <Ellipse Stroke="#BFFFFFFF" StrokeThickness="3" StrokeDashArray="2,1" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Message, Mode=OneWay}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,10,0,0" Height="4"
                                 IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="2" Width="94" Margin="16,0,0,0" Padding="8,5"
                        Command="{Binding CancelInstallCommand}"
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        IsEnabled="{Binding CancelEnabled, Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid x:Name="FallbackPanel" Background="#FF202020" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                <Image Source="{Binding Icon}" Width="64" Height="64" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Message}" Foreground="White" FontSize="17" TextAlignment="Center" Margin="0,18,0,12" TextWrapping="Wrap" />
                <ProgressBar Height="5" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
                <Button Width="100" Margin="0,18,0,0" Content="{x:Static resources:Strings.Common_Cancel}" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding CancelEnabled}" />
            </StackPanel>
        </Grid>
    </Grid>
</base:WpfUiWindow>
