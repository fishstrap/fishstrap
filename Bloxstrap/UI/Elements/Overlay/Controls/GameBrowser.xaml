<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.GameBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:control="clr-namespace:Bloxstrap.UI.Elements.Overlay.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="720"
             FontFamily="{StaticResource Inter}">

    <UserControl.Resources>
        <Style x:Key="TabToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="6">
                            <Grid>
                                <Border x:Name="HoverBd" CornerRadius="8" Margin="-6" Opacity="0" IsHitTestVisible="False"
                                        Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                                <Border x:Name="PressedBd" CornerRadius="8" Margin="-6" Opacity="0" IsHitTestVisible="False"
                                        Background="{ui:ThemeResource SubtleFillColorTertiaryBrush}" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding ActualHeight, ElementName=Header}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <Border Height="{Binding ActualHeight, ElementName=Header}" />

                <ItemsControl ItemsSource="{Binding ActiveTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tile" Style="{StaticResource GameTileButton}" Width="148" Margin="0,0,4,4"
                                    Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Mode=OneTime}"
                                    ToolTip="{Binding Name}">
                                <StackPanel>
                                    <Grid Width="136" Height="136">
                                        <Border x:Name="IconArt" CornerRadius="8" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding IconUrl}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <Grid x:Name="PlayBadge" Width="44" Height="44" Opacity="0" IsHitTestVisible="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="PlayScale" ScaleX="0.7" ScaleY="0.7" />
                                            </Grid.RenderTransform>
                                            <Border CornerRadius="22">
                                                <Border.Background>
                                                    <VisualBrush Visual="{Binding ElementName=IconArt}" Stretch="Fill"
                                                                 ViewboxUnits="Absolute" Viewbox="46,46,44,44"
                                                                 ViewportUnits="RelativeToBoundingBox" Viewport="0,0,1,1"
                                                                 TileMode="None" />
                                                </Border.Background>
                                                <Border.Effect>
                                                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                                                </Border.Effect>
                                                <Border.CacheMode>
                                                    <BitmapCache EnableClearType="False" />
                                                </Border.CacheMode>
                                            </Border>
                                            <Border CornerRadius="22" Opacity="0.55" IsHitTestVisible="False"
                                                    Background="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                                            <Border CornerRadius="22" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#59FFFFFF" />
                                                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="22" BorderBrush="White" BorderThickness="1" Opacity="0.35" IsHitTestVisible="False" />
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" />

                                    <TextBlock Text="{Binding PlayingText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Button>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Tile}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PlayBadge" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.7" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.7" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Width="32" Height="32"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid x:Name="Header" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top">
            <control:AcrylicBackdrop Source="{Binding ElementName=Scroller}" />

            <StackPanel>
                <Border Height="{Binding (control:OverlayPanel.HeaderInset), RelativeSource={RelativeSource Self}}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="3" CornerRadius="8" VerticalAlignment="Center"
                            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource TabToggle}" GroupName="GameBrowserTab"
                                         IsChecked="{Binding ShowingSearch, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Games_Search}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource TabToggle}" GroupName="GameBrowserTab" Margin="2,0,0,0"
                                         IsChecked="{Binding ShowingFavorites, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Star24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Games_Favorites}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <ui:TextBox Grid.Column="1" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                                PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Games_SearchPlaceholder}"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding ShowingSearch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Games_Continue}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding ShowContinueLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="2,0,0,8"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
