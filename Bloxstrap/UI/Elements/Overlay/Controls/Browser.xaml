<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.Browser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="960"
             FontFamily="{StaticResource Inter}"
             IsVisibleChanged="OnIsVisibleChanged">

    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource NavButton}" IsEnabled="False"
                       Click="BackClicked" ToolTip="{x:Static resources:Strings.Menu_Overlay_Browser_Back}">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" />
            </Button>

            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource NavButton}" IsEnabled="False"
                       Click="ForwardClicked" ToolTip="{x:Static resources:Strings.Menu_Overlay_Browser_Forward}">
                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" />
            </Button>

            <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource NavButton}"
                       Click="RefreshClicked" ToolTip="{x:Static resources:Strings.Menu_Overlay_Refresh}">
                <ui:SymbolIcon x:Name="RefreshIcon" Symbol="ArrowClockwise24" FontSize="16" />
            </Button>

            <Button Grid.Column="3" Style="{StaticResource NavButton}"
                       Click="HomeClicked" ToolTip="{x:Static resources:Strings.Menu_Overlay_Browser_Home}">
                <ui:SymbolIcon Symbol="Home24" FontSize="16" />
            </Button>

            <ui:TextBox x:Name="AddressBox" Grid.Column="4" Margin="6,0" FontSize="13" VerticalAlignment="Center"
                        PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Browser_AddressPlaceholder}"
                        KeyDown="AddressKeyDown"
                        GotKeyboardFocus="AddressGotFocus"
                        PreviewMouseLeftButtonDown="AddressMouseDown" />

            <Button Grid.Column="5" Style="{StaticResource NavButton}" Margin="0"
                       Click="OpenExternallyClicked" ToolTip="{x:Static resources:Strings.Menu_Overlay_Browser_OpenExternally}">
                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Border x:Name="ViewHost" Margin="6,0,6,6" />

            <TextBlock x:Name="FailedText" Text="{x:Static resources:Strings.Menu_Overlay_Browser_Failed}"
                       FontSize="13" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
