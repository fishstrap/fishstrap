<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.Notes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820"
             FontFamily="{StaticResource Inter}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="12" Margin="0,6,2,0"
                   HorizontalAlignment="Right"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

        <ui:TextBox Grid.Row="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Padding="12,10" FontSize="13"
                    AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    PlaceholderText="{x:Static resources:Strings.Menu_Overlay_Notes_Placeholder}"
                    Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
