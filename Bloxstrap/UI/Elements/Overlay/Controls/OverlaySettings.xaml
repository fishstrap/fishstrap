<UserControl x:Class="Bloxstrap.UI.Elements.Overlay.Controls.OverlaySettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:control="clr-namespace:Bloxstrap.UI.Elements.Overlay.Controls"
             xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="520"
             FontFamily="{StaticResource Inter}">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ui:ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <Border Height="{Binding ActualHeight, ElementName=Header}" />

                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Overlay}" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                            <TextBlock Text="{x:Static resources:Strings.Menu_Integrations_OverlayHotkey_Title}" Style="{StaticResource Label}" />
                            <TextBlock Text="{x:Static resources:Strings.Menu_Integrations_OverlayHotkey_Description}" Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding HotkeyTakenText}" Style="{StaticResource Hint}"
                                       Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding HotkeyTaken, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:HotkeyBox x:Name="ShortcutBox" Modifiers="{Binding HotkeyModifiers, Mode=TwoWay}" Key="{Binding HotkeyKey, Mode=TwoWay}" />
                            <ui:Button Width="38" Height="30" Margin="4,0,0,0" Icon="Backspace24"
                                       ToolTip="{x:Static resources:Strings.Menu_Integrations_OverlayHotkey_Reset}"
                                       Command="{Binding ResetHotkeyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Notifications}" Style="{StaticResource SectionTitle}" />

                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid x:Name="PreviewArea" Height="180" SizeChanged="PreviewSizeChanged" MouseLeftButtonUp="PreviewClicked"
                          Cursor="Hand" ToolTip="{x:Static resources:Strings.Menu_Overlay_Settings_Replay}">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2E3A55" Offset="0" />
                                <GradientStop Color="#FF1A2031" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Border x:Name="Backdrop" Opacity="0.55" />

                        <control:ToastCard x:Name="PreviewCard" />
                    </Grid>
                </Border>

                <ui:Button Margin="0,8,0,12" HorizontalAlignment="Right" Appearance="Secondary"
                           Command="{Binding TestCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Test}" FontSize="13" />
                    </StackPanel>
                </ui:Button>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Style}" Style="{StaticResource Label}" />

                            <Border Grid.Column="1" Padding="3" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastStyle"
                                                 IsChecked="{Binding IsCorner, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Enums_Overlay_ToastStyle_Corner}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastStyle" Margin="2,0,0,0"
                                                 IsChecked="{Binding IsFloating, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Enums_Overlay_ToastStyle_Floating}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Position}" Style="{StaticResource Label}" />

                            <ComboBox Grid.Column="1" MinWidth="160" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      ItemsSource="{Binding Positions, Mode=OneTime}" SelectedItem="{Binding Position, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_CornerRadius}" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Minimum="{Binding MinCornerRadius, Mode=OneTime}" Maximum="{Binding MaxCornerRadius, Mode=OneTime}"
                                    Value="{Binding CornerRadius, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding CornerRadiusText}" Style="{StaticResource Value}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Size}" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Minimum="{Binding MinSize, Mode=OneTime}" Maximum="{Binding MaxSize, Mode=OneTime}"
                                    Value="{Binding Size, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Value}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Background}" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Minimum="{Binding MinBackgroundOpacity, Mode=OneTime}" Maximum="{Binding MaxBackgroundOpacity, Mode=OneTime}"
                                    Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BackgroundOpacityText}" Style="{StaticResource Value}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Duration}" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Minimum="{Binding MinDuration, Mode=OneTime}" Maximum="{Binding MaxDuration, Mode=OneTime}"
                                    Value="{Binding Duration, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Value}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Animation}" Style="{StaticResource Label}" />

                            <ComboBox Grid.Column="1" MinWidth="190" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      ItemsSource="{Binding Animations, Mode=OneTime}" SelectedItem="{Binding Animation, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Header}" Style="{StaticResource Label}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_HeaderHint}" Style="{StaticResource Hint}" />
                            </StackPanel>

                            <Border Grid.Column="1" Padding="3" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastHeader" Padding="12,5"
                                                 IsChecked="{Binding HeaderOff, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Menu_Overlay_Settings_HeaderOff}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastHeader" Padding="12,5" Margin="2,0,0,0"
                                                 IsChecked="{Binding HeaderServer, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Menu_Overlay_Settings_HeaderServer}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastHeader" Padding="12,5" Margin="2,0,0,0"
                                                 IsChecked="{Binding HeaderFriends, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Menu_Overlay_Settings_HeaderFriends}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ToastHeader" Padding="12,5" Margin="2,0,0,0"
                                                 IsChecked="{Binding HeaderBoth, Mode=TwoWay}"
                                                 Content="{x:Static resources:Strings.Menu_Overlay_Settings_HeaderBoth}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_NotifyAbout}" Style="{StaticResource SectionTitle}" Margin="2,20,0,8" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_ServerDetails}" Style="{StaticResource Label}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_ServerDetailsHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ServerToasts, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Friends}" Style="{StaticResource Label}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_FriendsHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding FriendNotifications, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Badges}" Style="{StaticResource Label}" />
                                <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_BadgesHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding BadgeNotifications, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_StartHint}" Style="{StaticResource Label}" Margin="0,0,12,0" />
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding StartHint, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ui:Button Margin="0,16,0,4" HorizontalAlignment="Left" Appearance="Secondary" Command="{Binding ResetCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Overlay_Settings_Reset}" FontSize="13" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Header" VerticalAlignment="Top">
            <control:AcrylicBackdrop Source="{Binding ElementName=Scroller}" />

            <Border Height="{Binding (control:OverlayPanel.HeaderInset), RelativeSource={RelativeSource Self}}" />
        </Grid>
    </Grid>
</UserControl>
